# 复制本文件为 application-secrets.yml（已在 .gitignore，勿提交）
# 放在 quote-api 项目根目录，与 pom.xml 同级，然后重启后端

quote:
  ai:
    api-key: 在这里填写你的DashScope_Key
  mail:
    # 打开后：报价进入「已报价」会自动发打印模板 PDF
    enabled: true
    from: frd@sh-frd.com
    from-name: FRD GLOBAL (SH) CO., LTD.
    # Linux 服务器请配置可用中文字体，例如：
    # pdf-font-path: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

spring:
